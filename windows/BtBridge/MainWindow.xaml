<Window x:Class="BtBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BtBridge"
        Title="גשר בלוטוס" Height="740" Width="1160" MinWidth="800" MinHeight="500"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14"
        Background="#F5F7FA" WindowStartupLocation="CenterScreen" AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <DataTemplate DataType="{x:Type local:DeviceHeader}">
            <DockPanel Margin="0,10,0,2">
                <Button DockPanel.Dock="Left" Content="{Binding Action}" Visibility="{Binding ActionVisibility}"
                        Click="HeaderAction_Click" Padding="6,0" Margin="0" FontSize="12" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource Accent}" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" FontSize="12" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:DeviceItem}">
            <StackPanel Margin="2,5">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Sub}" Foreground="{Binding SubBrush}" FontSize="12" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="DeviceContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <!-- Devices -->
        <Border Grid.RowSpan="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="גשר בלוטוס" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="ListenText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,6" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <UniformGrid Columns="2">
                        <Button x:Name="ConnectBtn" Content="התחבר" Style="{StaticResource Primary}" Click="Connect_Click" />
                        <Button x:Name="DisconnectBtn" Content="נתק" Click="Disconnect_Click" />
                    </UniformGrid>
                    <Button Content="חפש וצמד מכשיר חדש…" Click="PairNew_Click" />
                    <Button Content="הגדרות" Click="Settings_Click" />
                </StackPanel>
                <ListBox x:Name="DeviceList" BorderThickness="0" SelectionChanged="DeviceList_SelectionChanged"
                         MouseDoubleClick="DeviceList_MouseDoubleClick" ItemContainerStyle="{StaticResource DeviceContainer}"
                         ContextMenuOpening="DeviceList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="MenuConnect" Header="התחבר" Click="Connect_Click" />
                            <MenuItem x:Name="MenuDisconnect" Header="נתק" Click="Disconnect_Click" />
                            <MenuItem Header="שנה כינוי…" Click="Rename_Device_Click" />
                            <MenuItem x:Name="MenuForget" Header="שכח מכשיר (בפעם הבאה תידרש סיסמה)" Click="Forget_Click" />
                            <Separator />
                            <MenuItem x:Name="MenuLog" Header="הצג את היומן של המכשיר (לבירור תקלות)" Click="DeviceLog_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Explorer -->
        <DockPanel Grid.Column="1" Margin="14,14,14,6">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel x:Name="SessionActions" DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="PhoneScreenBtn" Content="📱 מסך הטלפון" Click="PhoneScreen_Click" ToolTip="צפייה ושליטה במסך הטלפון" />
                    <Button Content="📤 שלח למכשיר…" Click="SendTo_Click" ToolTip="שולח קבצים לתיקיית ההורדות של המכשיר" />
                    <Button x:Name="RingBtn" Content="🔔 צלצל לטלפון" Click="Ring_Click" ToolTip="הטלפון יצלצל 30 שניות, גם כשהוא על שקט" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderSub" Foreground="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </DockPanel>
            <Border x:Name="VersionNotice" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FEF3C7" BorderBrush="#F59E0B"
                    BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="3,0,3,8">
                <DockPanel>
                    <Button x:Name="SendUpdateBtn" DockPanel.Dock="Left" Content="שלח עדכון לטלפון" Click="SendUpdate_Click"
                            Style="{StaticResource Primary}" Margin="8,0,0,0" />
                    <TextBlock x:Name="VersionText" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <WrapPanel x:Name="Toolbar" DockPanel.Dock="Top">
                <Button Content="→ חזור" Click="Back_Click" ToolTip="חזרה לתיקייה הקודמת" />
                <Button Content="⬆ למעלה" Click="Up_Click" ToolTip="לתיקייה שמעל" />
                <Button Content="⟳ רענן" Click="Refresh_Click" ToolTip="טען מחדש את התיקייה" />
                <Button Content="תיקייה חדשה" Click="NewFolder_Click" />
                <Button Content="העלה קבצים…" Click="UploadFiles_Click" ToolTip="אפשר גם לגרור לכאן, או להדביק" />
                <Button Content="העלה תיקייה…" Click="UploadFolder_Click" />
                <Button Content="⬇ הורד" Click="Download_Click" Style="{StaticResource Primary}" />
                <Button Content="פתח" Click="Open_Click" />
                <Button Content="שנה שם" Click="Rename_Click" ToolTip="F2" />
                <Button Content="מחק" Click="Delete_Click" ToolTip="מחיקת הפריטים שנבחרו" />
                <Button Content="☑ בחר הכל" Click="SelectAll_Click" ToolTip="Ctrl+A. אפשר גם לסמן כמה פריטים בתיבות הסימון שליד השמות" />
                <Button x:Name="SavedBtn" Content="★ שמורים" Click="Saved_Click" ToolTip="תיקיות וקבצים ששמרת במכשיר הזה" />
            </WrapPanel>
            <DockPanel DockPanel.Dock="Top" Margin="3,6,3,6">
                <Button DockPanel.Dock="Left" Content="🔍 חפש" Click="Search_Click" Margin="0" Padding="10,2"
                        ToolTip="מחפש בתיקייה הזו ובכל תתי-התיקיות שלה" />
                <Grid DockPanel.Dock="Left" Width="230" Margin="6,0,0,0">
                    <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"
                             ToolTip="חיפוש לפי חלק מהשם, בתיקייה הזו ובכל תתי-התיקיות. אנטר מחפש, אסקייפ חוזר." />
                    <TextBlock x:Name="SearchHint" Text="חיפוש בתיקייה הזו…" IsHitTestVisible="False" Margin="6,0"
                               VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                </Grid>
                <TextBox x:Name="PathBox" FlowDirection="LeftToRight" KeyDown="PathBox_KeyDown" ToolTip="הקלד נתיב ולחץ אנטר" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="4,0,4,4">
                <TextBlock x:Name="SelectionText" DockPanel.Dock="Left" FontSize="12" Foreground="{StaticResource Accent}" />
                <TextBlock x:Name="SortText" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           ToolTip="לחיצה על כותרת עמודה משנה את המיון. הבחירה נשמרת לכל תיקייה." />
            </DockPanel>
            <Grid>
                <ListView x:Name="FileList" SelectionMode="Extended" AllowDrop="True" BorderBrush="{StaticResource Line}"
                          MouseDoubleClick="FileList_MouseDoubleClick" Drop="FileList_Drop" DragOver="FileList_DragOver"
                          KeyDown="FileList_KeyDown" GridViewColumnHeader.Click="Header_Click" SelectionChanged="FileList_SelectionChanged"
                          ContextMenuOpening="FileList_ContextMenuOpening"
                          PreviewMouseLeftButtonDown="FileList_MarqueeDown" PreviewMouseMove="FileList_MarqueeMove"
                          PreviewMouseLeftButtonUp="FileList_MarqueeUp" LostMouseCapture="FileList_LostCapture">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="פתח" Click="Open_Click" />
                            <MenuItem x:Name="MenuOpenFolder" Header="פתח את התיקייה שמכילה" Click="OpenContainingFolder_Click" />
                            <MenuItem Header="העתק (להדבקה בסייר הקבצים)" Click="Copy_Click" />
                            <MenuItem Header="⬇ הורד" Click="Download_Click" />
                            <MenuItem Header="שנה שם" Click="Rename_Click" />
                            <MenuItem Header="מחק" Click="Delete_Click" />
                            <Separator />
                            <MenuItem x:Name="MenuSave" Header="★ הוסף לשמורים" Click="SaveItems_Click" />
                            <MenuItem x:Name="MenuUnsave" Header="הסר מהשמורים" Click="UnsaveItems_Click" />
                            <Separator />
                            <MenuItem Header="העתק נתיב" Click="CopyRemotePath_Click" />
                            <MenuItem Header="הדבק (העלה לכאן)" Click="Paste_Click" />
                            <MenuItem Header="תיקייה חדשה" Click="NewFolder_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <!-- A tick box on each row: several items can be marked with the mouse alone, no Ctrl needed. -->
                            <GridViewColumn Width="34">
                                <GridViewColumn.Header>
                                    <CheckBox x:Name="AllBox" Click="AllBox_Click" ToolTip="סמן הכל / בטל סימון" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Focusable="False"
                                                  IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="שם" Width="400">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="גודל" Width="100" DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Header="תאריך שינוי" Width="150" DisplayMemberBinding="{Binding DateText}" />
                            <!-- Shown only for search results: where each one is. -->
                            <GridViewColumn x:Name="FolderColumn" Header="תיקייה" Width="0" DisplayMemberBinding="{Binding Folder}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="{StaticResource Muted}" FontSize="16" TextWrapping="Wrap" MaxWidth="480" />
                <!-- The selection rectangle drawn while dragging with the mouse, as in File Explorer. -->
                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="Marquee" Visibility="Collapsed" Stroke="#3B82F6" StrokeThickness="1" Fill="#333B82F6" />
                </Canvas>
            </Grid>
        </DockPanel>

        <!-- Transfers -->
        <Border Grid.Column="1" Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,8">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Left" Content="נקה שהסתיימו" Click="ClearTransfers_Click" Padding="8,2" />
                    <Button DockPanel.Dock="Left" Content="פתח תיקיית הורדות" Click="OpenDownloads_Click" Padding="8,2" />
                    <TextBlock Text="העברות" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="TransferList" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="TransferList_MouseDoubleClick" ContextMenuOpening="TransferList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="MenuResume" Header="המשך מאיפה שנעצר" Click="TransferResume_Click" />
                            <MenuItem Header="פתח" Click="TransferOpen_Click" />
                            <MenuItem Header="הצג בתיקייה" Click="TransferShow_Click" />
                            <MenuItem Header="העתק נתיב" Click="TransferCopy_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Arrow}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip="{Binding LocalPath}" />
                                <ProgressBar Grid.Column="2" Value="{Binding Percent, Mode=OneWay}" Height="10" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Column="4" Text="{Binding Speed}" FontSize="12" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Column="5" Text="{Binding LinkKind}" FontSize="12" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Column="6" Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                                <Button Grid.Column="7" Content="✕" Padding="4,0" Margin="0" Click="CancelTransfer_Click" ToolTip="בטל"
                                        Visibility="{Binding Active, Converter={StaticResource Vis}}" />
                                <Button Grid.Column="7" Content="↻" Padding="4,0" Margin="0" Click="TransferResume_Click" ToolTip="המשך מאיפה שנעצר"
                                        Visibility="{Binding CanResume, Converter={StaticResource Vis}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
