<Window x:Class="BtBridge.PhoneScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="מסך הטלפון" Height="860" Width="460" MinWidth="320" MinHeight="420"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="13" Background="#111827"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown" TextInput="Window_TextInput">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Background="#1F2937">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Padding" Value="8,3" />
                    <Setter Property="Background" Value="#374151" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#4B5563" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </WrapPanel.Resources>
            <Button Content="◁ חזור" Click="Back_Click" ToolTip="גם: לחיצה ימנית על המסך" />
            <Button Content="○ בית" Click="Home_Click" />
            <Button Content="▢ אחרונים" Click="Recents_Click" />
            <Button Content="🔔" Click="Notifications_Click" ToolTip="התראות" />
            <Button Content="⚙" Click="Quick_Click" ToolTip="הגדרות מהירות" />
            <Button Content="🔒" Click="Lock_Click" ToolTip="נעילת מסך" />
            <ComboBox x:Name="ProfileBox" Width="110" Margin="3" SelectionChanged="Profile_Changed" Focusable="False">
                <ComboBoxItem Content="איכות: אוטומטי" Tag="auto" IsSelected="True" />
                <ComboBoxItem Content="חד" Tag="sharp" />
                <ComboBoxItem Content="מהיר" Tag="fast" />
            </ComboBox>
        </WrapPanel>
        <Border DockPanel.Dock="Bottom" Background="#1F2937" Padding="8,4">
            <TextBlock x:Name="StatusText" Foreground="#9CA3AF" TextWrapping="Wrap" />
        </Border>
        <Grid x:Name="Surface" Background="#111827" Focusable="True" FocusVisualStyle="{x:Null}">
            <Image x:Name="Screen" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" FlowDirection="LeftToRight"
                   MouseLeftButtonDown="Screen_Down" MouseLeftButtonUp="Screen_Up" MouseRightButtonUp="Screen_Right" MouseWheel="Screen_Wheel" />
            <TextBlock x:Name="WaitText" Foreground="White" FontSize="16" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />
        </Grid>
    </DockPanel>
</Window>
